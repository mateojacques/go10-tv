# Loaded by `vite build --mode tizen` (apps/tizen/scripts/build-prod.sh) only.
# The TV loads catalog art from the site, like the Android app, instead of
# carrying every thumbnail in its package (see apps/web/src/catalog/art.ts).
VITE_IMAGE_BASE=https://tv.go10.blog/
# The packaged app is file://, which YouTube refuses (error 153): YouTube
# embeds go through this page on the site instead (apps/web/public/yt.html).
VITE_YT_RELAY=https://tv.go10.blog/yt.html
